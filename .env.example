# --- IA (résumés en français) ---
ANTHROPIC_API_KEY=
# Modèle utilisé pour les résumés (Haiku = rapide et économique ; Sonnet = plus fin)
ANTHROPIC_MODEL=claude-haiku-5-5
# Nombre maximum de CVE résumées à chaque rafraîchissement
AI_MAX_SUMMARIES=40

# --- Sources ---
# Clé gratuite NVD (recommandée : 50 requêtes / 30 s au lieu de 5) : https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Fenêtre de publication couverte, en heures
FEED_WINDOW_HOURS=24

# --- Stack de départ, proposée à chaque nouveau compte (et utilisée pour le message Slack d'équipe) ---
STACK_KEYWORDS=fortinet, microsoft exchange, windows server, nginx, wordpress, cisco, vmware

# --- Comptes utilisateurs ---
# Base Postgres (Neon via le Marketplace Vercel, Supabase…). Les tables sont créées au déploiement.
DATABASE_URL=
# Secret de signature des sessions : 32 caractères aléatoires ou plus (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Adresse publique de l'application (ex. https://vigilantiq.vercel.app)
BETTER_AUTH_URL=
# Connexion Google : identifiants OAuth « Application Web » créés dans Google Cloud Console.
# URI de redirection autorisée à déclarer : <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Réserver l'inscription à certains domaines (ex. "entreprise.sn, filiale.sn"). Vide = ouvert à tous.
ALLOWED_EMAIL_DOMAINS=

# --- Digest quotidien (cron 07:00 UTC) ---
# Vercel envoie ce secret automatiquement au cron ; générez une valeur longue et aléatoire
CRON_SECRET=
# Adresse publique de l'app, utilisée dans les liens du digest
APP_URL=
# E-mails via Resend (https://resend.com) : digest par utilisateur, confirmation d'adresse, mot de passe oublié
RESEND_API_KEY=
DIGEST_FROM=VigilantIQ <alertes@votre-domaine.sn>
# Slack (Incoming Webhook)
SLACK_WEBHOOK_URL=

# --- Flux RSS (alertes en quasi temps réel) ---
# Flux supplémentaires : "Nom|https://url,Nom 2|https://url2"
RSS_EXTRA_FEEDS=
# Désactiver des flux par identifiant : certfr, certeu, cisa, certcc, zdi, msrc, cisco, fortinet, paloalto, ubuntu, exploitdb, cvefeed
RSS_DISABLE=
# Fraîcheur de chaque flux, en secondes
RSS_REVALIDATE_SECONDS=180
# Nombre max de CVE citées par les flux (hors fenêtre NVD) ajoutées au tableau
RSS_CVE_MAX=40
# Nombre max de fiches CVE.org (versions de l'éditeur) récupérées par rafraîchissement
CVEORG_MAX=80
